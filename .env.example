# Copy to .env and fill in. Never commit .env.

# Google Maps Platform — Places API (New).
# Needs a project with billing enabled; 500 merchants stays inside the free tier.
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=

# Google AI Studio — Gemini. Free tier, no billing account required.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional tuning (defaults live in src/config.py) ---

# Hard ceiling on Place Details calls, so a bad run cannot leave the free tier.
MAX_PLACE_DETAILS=600

# How many qualified leads the pipeline aims for.
TARGET_LEADS=500

# Gemini model used for classification and message generation.
GEMINI_MODEL=gemini-2.0-flash
