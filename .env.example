# Copy to .env and fill in. Never commit .env.

# Google Maps Platform — Places API (New). Needs a project with billing enabled.
# Reaching 500 qualified leads takes ~2,350 Enterprise screenings, so roughly
# 1,350 of them fall outside the 1,000/month free allowance: about $27 USD.
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=

# Google AI Studio — Gemini. Free tier, no billing account required.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional tuning (defaults live in src/config.py) ---

# Hard ceiling on Place Details screening calls. This is the safety net against
# a runaway run, not the normal stop condition.
MAX_PLACE_DETAILS=2500

# How many qualified leads the pipeline aims for. Screening stops as soon as
# enough prospects have survived it, so this is what normally ends the run.
TARGET_LEADS=500

# Optional review purchases. Reviews are the Enterprise + Atmosphere SKU, the
# priciest in the catalog, and it carries its own free cap of 1,000 calls per
# month. They never qualify a merchant — Google's structured paymentOptions
# field does — so they only buy a sharper quote for the opening message, and
# they are the first thing cut. Set to 0 to skip them entirely; lower it if
# part of the month's free allowance is already gone.
REVIEW_BUDGET=1000

# Gemini model used for classification and message generation. The floating
# alias is deliberate: pinned Gemini versions get retired and a stale pin makes
# a fresh clone fail with a 404. Pin an explicit version if you need frozen
# behaviour more than you need the repo to run.
GEMINI_MODEL=gemini-flash-latest

# Merchants per Gemini call. Batching amortizes the ~3K-token MCC catalog prefix.
GEMINI_BATCH_SIZE=10
